{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/share/:date*",
      "destination": "/api/share/:date*"
    },
    {
      "source": "/home-share",
      "destination": "/api/home-share"
    },
    {
      "source": "/newspaper/:date",
      "destination": "/index.html"
    },
    {
      "source": "/calendar",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/index.html"
    }
  ]
}